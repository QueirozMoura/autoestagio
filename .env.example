# Copie para .env e ajuste conforme necessário.

# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_PATH=data/autoestagio.db

# Caminho do perfil pessoal (copie config/profile.example.json para config/profile.json)
PROFILE_PATH=config/profile.json

# Modo de candidatura: dry-run | manual | auto
# O envio autônomo só é possível com todas as travas e manifesto revisto.
APPLY_MODE=dry-run

# off | simulate | real. Não habilitar real antes de revisar a política/concessão.
AUTO_APPLY=off

# Trava adicional para envio autônomo real
ALLOW_AUTO_APPLY=false

# Limite de candidaturas por dia (o canal de e-mail aplica janela móvel de 24 h)
MAX_APPLICATIONS_PER_DAY=10

# Canal de e-mail (Gmail). Nada é enviado enquanto EMAIL_SEND_ENABLED=false (padrão).
EMAIL_SEND_ENABLED=false
# Credencial OAuth do tipo "App para computador" baixada do Google Cloud Console (fora do Git)
GOOGLE_OAUTH_CLIENT_PATH=config/google-oauth-client.json
# Token OAuth local, criado por "email auth login" (arquivo 0600, fora do Git)
GMAIL_TOKEN_PATH=data/gmail-token.json
# Sua caixa de teste: {"testMailbox": "voce@exemplo.com"} (fora do Git)
EMAIL_CONFIG_PATH=config/email.json

# Modelo mestre do currículo (dados pessoais; fora do Git). Criado por "cv extract".
CV_MODEL_PATH=config/cv-master.json
