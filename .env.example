# Copie para .env e ajuste conforme necessário.

# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_PATH=data/autoestagio.db

# Caminho do perfil pessoal (copie config/profile.example.json para config/profile.json)
PROFILE_PATH=config/profile.json

# Modo de candidatura: dry-run | manual | auto
# "auto" está desabilitado e ainda não implementado.
APPLY_MODE=dry-run

# Trava adicional para o modo auto (reservada para etapa futura)
ALLOW_AUTO_APPLY=false

# Limite de candidaturas por dia (usado em etapas futuras)
MAX_APPLICATIONS_PER_DAY=10
